  "feet_planted_rule": "Every frame anchored by its own alpha bbox bottom == ground_y; scaling grows upward from the feet, never from centre or plate bottom.",
  "no_crop_rule": "Canvas 1600x1800 fits giant (2.0x) with margin; gate fails on edge touch.",
  "background_note": "GIF/MP4 are on grey-128 video background for playback; the figure layer itself is transparent (see clean PNG plates). Ground-line red marker appears on proof images only, never on clean composites.",
  "methods": [
    {
      "name": "Perspective scaling / depth cueing",
      "source": "depth-by-scale test, scale=1.0+0.25*Z, extended to power scale 0.5-2.0",
      "wired": "anchor_layer() scale parameter, measured feet_y per frame",
      "run": "real"
    },
    {
      "name": "Multiplane parallax",
      "source": "depth test multiplane camera, far 0.3 / cape 1.0 / foreground 1.8",
      "wired": "background() distant blocks drift at 0.3x figure scale change",
      "run": "real (simple blocks, not a full multiplane render)"
    },
    {
      "name": "Disney squash and stretch",
      "source": "Disney 12 principles",
      "wired": "width squash 0.95 mid-growth segment, feet anchor recomputed after squash",
      "run": "real"
    },
    {
      "name": "Walk-cycle contact / passing / down / up",
      "source": "Williams, Animator's Survival Kit walk positions",
      "wired": "walk keys CONTACT-L/PASSING/CONTACT-R + DOWN/UP phase labels in measurements",
      "run": "real (rig-angle interpolation, not hand-drawn keys)"
    },
    {
      "name": "2D foot-plant anchor (IK-style, not a solver)",
      "source": "foot-locking / IK foot plant concept, 2D anchor method",
      "wired": "bbox-bottom anchor to ground_y every frame; stance foot is bbox bottom",
      "run": "real, labelled NOT a true IK solver"
    }
  ],
  "honest_limits": [
    "Walk keys are rig-angle configs written for this template, not measured from an existing walk clip; the walk clips on disk are RGB full-canvas, not transparent rig poses, so they could not be used as keys.",
    "Coming-forward has no true walk-cycle keys from the sheets and no background parallax render beyond simple blocks; background parallax for a full scene is still owed.",
    "MP4/GIF use a grey video background; only the figure layer and the two clean PNG plates are transparent."
  ],
