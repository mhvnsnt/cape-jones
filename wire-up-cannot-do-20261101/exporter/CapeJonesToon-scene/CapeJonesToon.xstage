<?xml version="1.0" ?>
<xstage version="prototype-1" name="CapeJonesToon" resolution="1100x1500" fps="24" frames="48">
  <note>PROTOTYPE ONLY. Built from public docs, not from Toon Boom code. Harmony import is UNVERIFIED until a real Harmony binary opens it.</note>
