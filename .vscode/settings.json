{
    // cape-jones local IDE settings. Owned by the IDE-config lane; other lanes
    // keep their configs in .devcontainer/ or their own dotfiles, not here.
    //
    // Blender-aware Python:
    // - The devcontainer bakes Blender 4.5.12 LTS into /opt. Blender ships its
    //   own Python 3.11 at /opt/blender-4.5.12-linux-x64/4.5/python/bin/python3.11.
    //   Point python.defaultInterpreterPath there when editing scripts that run
    //   INSIDE Blender (bpy available). Keep the system python for repo tooling
    //   that runs OUTSIDE Blender (aider, kaggle CLI, verify scripts).
    "python.defaultInterpreterPath": "/usr/local/bin/python",
    // Let the Blender Development extension install its fake-bpy stubs into the
    // selected interpreter so `import bpy` autocompletes outside Blender.
    "blender.allowModifyExternalPython": true,
    // Editor defaults mirror .editorconfig (which wins where both apply).
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.trimAutoWhitespace": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.eol": "\n",
    // Blend files are binary; never try to render a diff on them.
    "files.associations": {
        "*.blend": "binary",
        "*.blend1": "binary"
    },
    // Jupyter notebooks live in production/colab/; keep the kernel picker on the
    // venv python, not a stale global.
    "jupyter.askForKernelRestart": false
}
