{
    // Debug/run configs for cape-jones. Two lanes, no bloat:
    // 1. Scripts that run INSIDE Blender (bpy) -> "blender" type, needs the
    //    Blender Development extension (see extensions.json).
    // 2. Plain repo tooling that runs OUTSIDE Blender -> standard python type.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Blender: run current script (background)",
            "type": "blender",
            "request": "launch",
            "program": "${file}",
            // Headless run of the open .py inside Blender, factory settings so
            // user prefs on the box cannot skew a test render.
            "launchArgs": ["--background", "--factory-startup"]
        },
        {
            "name": "Python: current file (repo tooling)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
