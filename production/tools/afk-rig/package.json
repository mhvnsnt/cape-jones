{
  "name": "afk-rig",
  "version": "0.1.2",
  "description": "Free, local auto-rigging for 3D models, built for AI agents. Fit a skeleton to a GLB, let your AI inspect and adjust it, bind it and export with 250+ animations. CLI and MCP server.",
  "type": "module",
  "bin": {
    "afk-rig": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "npm run assets && npm run build"
  },
  "keywords": [
    "rigging",
    "auto-rig",
    "autorig",
    "skeleton",
    "glb",
    "gltf",
    "animation",
    "3d",
    "mcp",
    "ai",
    "threejs",
    "mixamo",
    "game-dev"
  ],
  "homepage": "https://afk.ai/developers",
  "bugs": {
    "email": "burtndylan@gmail.com"
  },
  "license": "MIT",
  "author": "afk.ai",
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.3.0",
    "three": "^0.185.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.185.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
